#!/usr/bin/env python3
"""
agy-title-zh: 自动将 Antigravity CLI / 桌面端中的英文会话标题与摘要汉化。
适配 agy 1.5.5+ 与 Antigravity 桌面端：同步更新 conversation_summaries(title/preview/raw_summary)、
conversations_fts 全文索引、annotations/<cid>.pbtxt 以及 proto store
（CLI 为 jetbox_summaries_proto.pb，桌面端为 agyhub_summaries_proto.pb）。
供 agy-wrapper 在 CLI 会话退出时后台异步调用，或退出桌面端后离线批量执行。
"""

import argparse
from datetime import datetime
import glob
import json
import os
from pathlib import Path
import re
import shutil
import socket
import sqlite3
import subprocess
import sys
import urllib.parse
from typing import Dict, List, Optional, Tuple

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _agy_pb import (  # noqa: E402
    atomic_write_bytes,
    atomic_write_text,
    create_rolling_backup,
    encode_pb_fields,
    parse_pb_fields,
    upsert_len_field,
)

TARGET_DBS = {
    "cli": os.path.expanduser("~/.gemini/antigravity-cli/conversation_summaries.db"),
    "desktop": os.path.expanduser("~/.gemini/antigravity/conversation_summaries.db"),
}
PROTO_STORE_NAMES = ("jetbox_summaries_proto.pb", "agyhub_summaries_proto.pb")
CJK_RE = re.compile(r"[\u4e00-\u9fff]")
ASCII_LETTER_RE = re.compile(r"[a-zA-Z]")
PBTXT_TITLE_RE = re.compile(r'^(title\s*:\s*)"((?:[^"\\]|\\.)*)"', re.M)


class RateLimitError(RuntimeError):
    """远端翻译接口返回 HTTP 429 频率限制。"""


def has_chinese(text: str) -> bool:
    return bool(CJK_RE.search(text or ""))


def needs_translation(text: str) -> bool:
    """判断文本是否为待汉化的英文自然语言标题/摘要，跳过纯路径、URL 与斜杠命令。"""
    cleaned = (text or "").strip()
    if not cleaned or has_chinese(cleaned) or not ASCII_LETTER_RE.search(cleaned):
        return False
    if " " not in cleaned and (
        cleaned.startswith("/") or cleaned.startswith("http") or "://" in cleaned
    ):
        return False
    return True


def _local_proxy_listening(proxy: str) -> bool:
    m = re.match(r"^[a-z0-9+.-]+://(127\.0\.0\.1|localhost):(\d+)", proxy)
    if not m:
        return True
    host, port = m.group(1), int(m.group(2))
    try:
        with socket.create_connection((host, port), timeout=0.4):
            return True
    except OSError:
        return False


def get_proxy(explicit_proxy: str = "") -> str:
    """选择可用代理；未指定且本地常见代理端口未监听时直接返回空串走直连（不额外发探测请求）。"""
    if explicit_proxy:
        return explicit_proxy
    candidates = []
    env_proxy = (
        os.environ.get("all_proxy")
        or os.environ.get("ALL_PROXY")
        or os.environ.get("https_proxy")
        or os.environ.get("HTTPS_PROXY")
        or os.environ.get("http_proxy")
        or os.environ.get("HTTP_PROXY")
        or ""
    )
    if env_proxy:
        candidates.append(env_proxy)
    candidates.extend(["socks5://127.0.0.1:7899", "http://127.0.0.1:7897"])

    for proxy in candidates:
        if proxy and _local_proxy_listening(proxy):
            return proxy
    return ""


def clean_for_translation(text: str, limit: int = 100) -> str:
    cleaned = re.sub(r"\s+", " ", text).strip()
    if len(cleaned) > limit:
        cleaned = cleaned[:limit]
    return cleaned


def _curl_translate(texts: List[str], proxy: str) -> Optional[List[str]]:
    cleaned_texts = [clean_for_translation(t) for t in texts]
    joined = "\n".join(cleaned_texts)
    url = (
        "https://translate.googleapis.com/translate_a/single"
        "?client=gtx&sl=auto&tl=zh-CN&dt=t&q="
        + urllib.parse.quote(joined)
    )
    cmd = ["curl", "-s", "-w", "\n%{http_code}", "--max-time", "8"]
    if proxy:
        cmd.extend(["-x", proxy])
    cmd.append(url)
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        if res.returncode != 0 or not res.stdout.strip():
            return None
        body, _, code = res.stdout.rpartition("\n")
        if code.strip() == "429":
            raise RateLimitError("HTTP 429")
        if not code.strip().startswith("2"):
            return None
        data = json.loads(body)
        translated_parts = [part[0] for part in data[0] if part and part[0]]
        results = "".join(translated_parts).split("\n")
        if len(results) == len(texts):
            return [r.strip() for r in results]
    except RateLimitError:
        raise
    except Exception:
        pass
    return None


def translate_texts(texts: List[str], proxy: str) -> Dict[str, str]:
    """批量翻译去重后的文本列表；若批量行数不对齐则自动二分降级，遇 429 立即熔断。"""
    unique_texts = list(dict.fromkeys(texts))
    mapping: Dict[str, str] = {}

    def _run(chunk: List[str]) -> None:
        if not chunk:
            return
        res = _curl_translate(chunk, proxy)
        if res is not None:
            for orig, trans in zip(chunk, res):
                mapping[orig] = trans
            return
        if len(chunk) == 1:
            mapping[chunk[0]] = chunk[0]
            return
        mid = len(chunk) // 2
        _run(chunk[:mid])
        _run(chunk[mid:])

    batch_size = 20
    for i in range(0, len(unique_texts), batch_size):
        _run(unique_texts[i : i + batch_size])
    return mapping


def patch_raw_summary(
    blob: Optional[bytes], new_title: Optional[str], new_preview: Optional[str]
) -> Optional[bytes]:
    """局部替换 CascadeTrajectorySummary protobuf 中的 summary(1) 与 annotations.title(15.1)。"""
    if not blob:
        return blob
    fields = parse_pb_fields(blob)
    if fields is None:
        return blob

    if new_preview is not None:
        fields = upsert_len_field(fields, 1, new_preview.encode("utf-8"))

    if new_title is not None:
        ann_payload = None
        for fn, wt, payload in fields:
            if fn == 15 and wt == 2:
                ann_payload = payload
                break
        if ann_payload is not None:
            ann_fields = parse_pb_fields(ann_payload)
            if ann_fields is None:
                return blob
            ann_fields = upsert_len_field(
                ann_fields, 1, new_title.encode("utf-8")
            )
        else:
            ann_fields = [(1, 2, new_title.encode("utf-8"))]
        fields = upsert_len_field(fields, 15, encode_pb_fields(ann_fields))

    patched = encode_pb_fields(fields)
    if parse_pb_fields(patched) is None:
        return blob
    return patched


def extract_pb_summary_texts(blob: bytes) -> Tuple[str, str]:
    """从 CascadeTrajectorySummary protobuf 提取 (summary, annotations.title)。"""
    fields = parse_pb_fields(blob)
    if not fields:
        return "", ""
    summary = ""
    ann_title = ""
    for fn, wt, payload in fields:
        if fn == 1 and wt == 2:
            summary = payload.decode("utf-8", errors="replace")
        elif fn == 15 and wt == 2:
            sub = parse_pb_fields(payload) or []
            for sfn, swt, spayload in sub:
                if sfn == 1 and swt == 2:
                    ann_title = spayload.decode("utf-8", errors="replace")
                    break
    return summary, ann_title


def collect_proto_texts(proto_path: str) -> List[str]:
    """收集 summaries proto（jetbox/agyhub）中仍为英文的标题与摘要文本。"""
    if not os.path.isfile(proto_path):
        return []
    try:
        blob = open(proto_path, "rb").read()
    except OSError:
        return []
    entries = parse_pb_fields(blob)
    if not entries:
        return []
    out: List[str] = []
    for fn, wt, payload in entries:
        if fn != 1 or wt != 2:
            continue
        kv = parse_pb_fields(payload) or []
        val = next((p for f, w, p in kv if f == 2 and w == 2), b"")
        if not val:
            continue
        pv, tt = extract_pb_summary_texts(val)
        if needs_translation(tt):
            out.append(tt.strip())
        if needs_translation(pv):
            out.append(pv.strip())
    return out


def patch_summaries_proto(
    proto_path: str,
    zh_titles: Dict[str, str],
    zh_previews: Dict[str, str],
    translations: Dict[str, str],
    dry_run: bool,
    create_bak: bool,
) -> int:
    """同步更新 summaries proto 文件（保留字段 2 等其他字段），防止启动对账覆盖 SQLite。"""
    if not os.path.isfile(proto_path):
        return 0
    blob = open(proto_path, "rb").read()
    entries = parse_pb_fields(blob)
    if not entries:
        return 0

    new_entries: List[Tuple[int, int, bytes]] = []
    patched_count = 0
    for fn, wt, payload in entries:
        if fn != 1 or wt != 2:
            new_entries.append((fn, wt, payload))
            continue
        kv = parse_pb_fields(payload)
        if not kv:
            new_entries.append((fn, wt, payload))
            continue
        cid = next((p.decode("utf-8", errors="replace") for f, w, p in kv if f == 1 and w == 2), "")
        val = next((p for f, w, p in kv if f == 2 and w == 2), b"")
        if not cid or not val:
            new_entries.append((fn, wt, payload))
            continue

        cur_pv, cur_tt = extract_pb_summary_texts(val)
        new_tt: Optional[str] = None
        new_pv: Optional[str] = None

        if needs_translation(cur_tt):
            if cid in zh_titles and has_chinese(zh_titles[cid]):
                new_tt = zh_titles[cid]
            else:
                new_tt = cap_translated(translations.get(cur_tt.strip(), ""), cur_tt.strip(), 30)
        if needs_translation(cur_pv):
            if cid in zh_previews and has_chinese(zh_previews[cid]):
                new_pv = zh_previews[cid]
            else:
                new_pv = cap_translated(translations.get(cur_pv.strip(), ""), cur_pv.strip(), 45)

        if new_tt is not None or new_pv is not None:
            new_val = patch_raw_summary(val, new_tt, new_pv)
            if new_val and new_val != val:
                new_kv = upsert_len_field(kv, 2, new_val)
                new_entries.append((fn, wt, encode_pb_fields(new_kv)))
                patched_count += 1
                continue
        new_entries.append((fn, wt, payload))

    if patched_count == 0 or dry_run:
        return patched_count

    out_blob = encode_pb_fields(new_entries)
    if parse_pb_fields(out_blob) is None:
        return 0
    if create_bak:
        shutil.copy2(proto_path, proto_path + ".bak")
    atomic_write_bytes(proto_path, out_blob, prefix=".protozh_")
    return patched_count


def _unescape_pbtxt(raw: str) -> str:
    return (
        raw.replace(r"\\", "\x00")
        .replace(r"\"", '"')
        .replace(r"\n", "\n")
        .replace(r"\r", "\r")
        .replace(r"\t", "\t")
        .replace("\x00", "\\")
    )


def _escape_pbtxt(text: str) -> str:
    return (
        text.replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\t", "\\t")
    )


def update_pbtxt_title(pbtxt_path: str, new_title: str, dry_run: bool) -> bool:
    if not os.path.isfile(pbtxt_path):
        return False
    with open(pbtxt_path, "r", encoding="utf-8") as f:
        content = f.read()
    m = PBTXT_TITLE_RE.search(content)
    if not m:
        return False
    if _unescape_pbtxt(m.group(2)) == new_title:
        return False
    if dry_run:
        return True
    escaped = _escape_pbtxt(new_title)
    new_content = PBTXT_TITLE_RE.sub(lambda match: f'{match.group(1)}"{escaped}"', content, count=1)
    atomic_write_text(pbtxt_path, new_content, prefix=".titlezh_")
    return True


def cap_translated(text: str, orig: str, max_len: int) -> Optional[str]:
    if not text or text == orig or not has_chinese(text):
        return None
    return text[:max_len] if len(text) > max_len else text


def find_busy_pids(paths: List[str]) -> List[str]:
    """用 lsof 检查是否有活跃进程正打开目标库/proto（防止桌面端运行时发生冲突或覆盖）。"""
    existing = [p for p in paths if os.path.exists(p)]
    if not existing or not shutil.which("lsof"):
        return []
    try:
        res = subprocess.run(
            ["lsof", "-t", "--", *existing],
            capture_output=True,
            text=True,
            timeout=3,
        )
        return sorted({line.strip() for line in res.stdout.splitlines() if line.strip().isdigit()})
    except Exception:
        return []


def create_offline_snapshot(
    conn: sqlite3.Connection, base_dir: str, proto_paths: List[str], ann_dir: str
) -> str:
    """为桌面端离线批量操作创建带时间戳的完整可回滚备份目录。"""
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    bak_dir = os.path.join(base_dir, "backups", f"title-zh-{ts}")
    os.makedirs(bak_dir, mode=0o700, exist_ok=True)
    dst = sqlite3.connect(os.path.join(bak_dir, "conversation_summaries.db"))
    try:
        conn.backup(dst)
    finally:
        dst.close()
    for p in proto_paths:
        if os.path.isfile(p):
            shutil.copy2(p, os.path.join(bak_dir, os.path.basename(p)))
    if os.path.isdir(ann_dir):
        shutil.copytree(ann_dir, os.path.join(bak_dir, "annotations"), dirs_exist_ok=True)
    return bak_dir


def process_db(
    label: str,
    db_path: str,
    dry_run: bool,
    no_backup: bool,
    explicit_proxy: str,
    verbose: bool,
) -> int:
    db_path = os.path.expanduser(db_path)
    if not os.path.exists(db_path):
        if verbose:
            print(f"[{label}] 跳过：未找到数据库 {db_path}")
        return 0

    base_dir = os.path.dirname(db_path)
    ann_dir = os.path.join(base_dir, "annotations")
    proto_paths = [
        os.path.join(base_dir, name)
        for name in PROTO_STORE_NAMES
        if os.path.isfile(os.path.join(base_dir, name))
    ]
    is_desktop = (
        label == "desktop"
        or os.path.basename(base_dir) == "antigravity"
        or any(os.path.basename(p) == "agyhub_summaries_proto.pb" for p in proto_paths)
    )

    if not dry_run and is_desktop:
        busy_pids = find_busy_pids([db_path, db_path + "-wal", db_path + "-shm", *proto_paths])
        if busy_pids:
            print(
                f"✗ [{label}] 检测到桌面端进程正占用数据文件（PID: {', '.join(busy_pids)}）。"
                "请先完全退出 Antigravity 桌面端后再执行离线批量汉化。",
                file=sys.stderr,
            )
            return 1

    try:
        if dry_run and is_desktop:
            conn = sqlite3.connect(Path(db_path).as_uri() + "?immutable=1", uri=True)
        else:
            conn = sqlite3.connect(db_path, timeout=5.0)
        c = conn.cursor()
        rows = c.execute(
            "SELECT conversation_id, title, preview, raw_summary "
            "FROM conversation_summaries "
            "WHERE title != '' OR preview != ''"
        ).fetchall()

        pbtxt_titles: Dict[str, str] = {}
        if os.path.isdir(ann_dir):
            for fp in glob.glob(os.path.join(ann_dir, "*.pbtxt")):
                cid = os.path.splitext(os.path.basename(fp))[0]
                try:
                    txt = open(fp, "r", encoding="utf-8", errors="ignore").read()
                except OSError:
                    continue
                m = PBTXT_TITLE_RE.search(txt)
                if m:
                    pbtxt_titles[cid] = _unescape_pbtxt(m.group(2))

        pending_texts: List[str] = []
        for cid, title, preview, _ in rows:
            if needs_translation(title):
                pending_texts.append(title.strip())
            if needs_translation(preview):
                pending_texts.append(preview.strip())
            pb_t = pbtxt_titles.get(cid, "")
            if needs_translation(pb_t):
                pending_texts.append(pb_t.strip())
        for pp in proto_paths:
            pending_texts.extend(collect_proto_texts(pp))

        if not pending_texts:
            conn.close()
            if verbose:
                print(f"✓ [{label}] 没有需要汉化的英文标题或摘要")
            return 0

        proxy = get_proxy(explicit_proxy)
        try:
            translations = translate_texts(pending_texts, proxy)
        except RateLimitError:
            conn.close()
            if verbose:
                print(
                    f"⚠ [{label}] translate.googleapis.com 返回 HTTP 429（请求频率受限），"
                    "请稍后再试或通过 --proxy 指定其他出口",
                    file=sys.stderr,
                )
            return 1

        updates = []
        pbtxt_updates: List[Tuple[str, str]] = []
        zh_titles: Dict[str, str] = {}
        zh_previews: Dict[str, str] = {}
        for cid, title, preview, raw_summary in rows:
            orig_t = (title or "").strip()
            orig_p = (preview or "").strip()
            new_t = title
            new_p = preview
            t_changed = False
            p_changed = False

            if needs_translation(orig_t):
                cand = cap_translated(translations.get(orig_t, ""), orig_t, 30)
                if cand:
                    new_t = cand
                    t_changed = True
            if needs_translation(orig_p):
                cand = cap_translated(translations.get(orig_p, ""), orig_p, 45)
                if cand:
                    new_p = cand
                    p_changed = True

            if has_chinese(new_t):
                zh_titles[cid] = new_t
            if has_chinese(new_p):
                zh_previews[cid] = new_p

            if t_changed or p_changed:
                new_raw = patch_raw_summary(
                    raw_summary,
                    new_t if t_changed else None,
                    new_p if p_changed else None,
                )
                fts_title = new_t if new_t else new_p
                updates.append((new_t, new_p, new_raw, fts_title, cid))

            pb_t = pbtxt_titles.get(cid, "").strip()
            if needs_translation(pb_t):
                target_pb_t = new_t if t_changed else (
                    new_t if has_chinese(new_t) else cap_translated(translations.get(pb_t, ""), pb_t, 30)
                )
                if target_pb_t and has_chinese(target_pb_t):
                    pbtxt_updates.append((os.path.join(ann_dir, f"{cid}.pbtxt"), target_pb_t))
                    zh_titles.setdefault(cid, target_pb_t)
            elif t_changed and cid in pbtxt_titles:
                pbtxt_updates.append((os.path.join(ann_dir, f"{cid}.pbtxt"), new_t))

        snapshot_dir = ""
        if (updates or pbtxt_updates) and not dry_run and not no_backup:
            create_rolling_backup(conn, db_path)
            if is_desktop:
                snapshot_dir = create_offline_snapshot(conn, base_dir, proto_paths, ann_dir)

        db_updated = 0
        if not dry_run and updates:
            has_fts = bool(
                c.execute(
                    "SELECT 1 FROM sqlite_master WHERE type='table' AND name='conversations_fts'"
                ).fetchone()
            )
            for new_t, new_p, new_raw, fts_title, cid in updates:
                c.execute(
                    "UPDATE conversation_summaries SET title = ?, preview = ?, raw_summary = ? "
                    "WHERE conversation_id = ?",
                    (new_t, new_p, new_raw, cid),
                )
                if has_fts:
                    c.execute(
                        "UPDATE conversations_fts SET title = ? "
                        "WHERE conversation_id = ? AND chunk_index = -1",
                        (fts_title, cid),
                    )
                db_updated += 1
            conn.commit()
        elif dry_run:
            db_updated = len(updates)

        conn.close()

        pbtxt_updated = 0
        for pb_path, pb_new_title in pbtxt_updates:
            if update_pbtxt_title(pb_path, pb_new_title, dry_run=dry_run):
                pbtxt_updated += 1

        proto_updated = 0
        for pp in proto_paths:
            proto_updated += patch_summaries_proto(
                pp,
                zh_titles,
                zh_previews,
                translations,
                dry_run=dry_run,
                create_bak=not no_backup,
            )

        if verbose:
            prefix = "[dry-run] " if dry_run else ""
            route_desc = proxy if proxy else "直连"
            bak_note = f"，备份: {snapshot_dir}" if snapshot_dir else ""
            print(
                f"✓ [{label}] {prefix}成功汉化 {db_updated} 条 DB 会话记录、"
                f"{pbtxt_updated} 个 annotations 文件、"
                f"{proto_updated} 条 proto store 记录（路线: {route_desc}{bak_note}）"
            )
        return 0
    except Exception as e:
        if verbose:
            print(f"[{label}] Error: {e}", file=sys.stderr)
        return 1


def main() -> int:
    parser = argparse.ArgumentParser(description="汉化 agy CLI / Antigravity 桌面端会话标题与摘要")
    parser.add_argument(
        "--target",
        choices=["cli", "desktop", "all"],
        default="cli",
        help="目标环境：cli (默认)、desktop (需先退出桌面端) 或 all",
    )
    parser.add_argument("--db", default="", help="手动指定 conversation_summaries.db 路径（覆盖 --target）")
    parser.add_argument("--proxy", default="", help="显式指定翻译出口代理，如 socks5://127.0.0.1:7899")
    parser.add_argument("--dry-run", action="store_true", help="仅统计与试译，不写入文件")
    parser.add_argument("--no-backup", action="store_true", help="跳过写入前的备份")
    parser.add_argument("-v", "--verbose", action="store_true", help="打印详细执行信息")
    args = parser.parse_args()

    if args.db:
        return process_db("custom", args.db, args.dry_run, args.no_backup, args.proxy, args.verbose)

    targets = ["cli", "desktop"] if args.target == "all" else [args.target]
    rc = 0
    for label in targets:
        res = process_db(
            label, TARGET_DBS[label], args.dry_run, args.no_backup, args.proxy, args.verbose
        )
        if res != 0:
            rc = res
    return rc


if __name__ == "__main__":
    sys.exit(main())
