#!/bin/sh
# agy 的代理外壳 —— 装成 ~/.local/overrides/agy(排在 PATH 最前,盖住真二进制)。
#
# 干三件事:
#   1. 让 agy(且只让 agy)走自有硅谷出口 —— 见 agy-tunnel。机场 IP 是共用机房段,Google 判定飘忽,
#      同一轮里前几个请求成功、下一个就 "User location is not supported",整轮被掐断。
#      通道不在 → 退回本地代理 7897;都不在 → 裸连。
#   2. 若未传 --dangerously-skip-permissions 且需强制绕过确认，可自动注入(注: 新版也支持 settings.json
#      中配置 "toolPermission": "always-proceed")；同时将当前目录通过 --add-dir 钉成工作区。
#   3. 实例开太多时提前告警 —— 多实例共享同一套登录刷新周期可能触发 401(见 tips/15)。
TUN=7899
AIRPORT=7897
P=""
if nc -z -G 1 127.0.0.1 "$TUN" 2>/dev/null; then
  P="socks5://127.0.0.1:$TUN"
elif nc -z -G 1 127.0.0.1 "$AIRPORT" 2>/dev/null; then
  P="http://127.0.0.1:$AIRPORT"
fi
if [ -n "$P" ]; then
  export http_proxy="$P" https_proxy="$P" all_proxy="$P"
  export HTTP_PROXY="$P" HTTPS_PROXY="$P" ALL_PROXY="$P"
  export no_proxy="localhost,127.0.0.1" NO_PROXY="localhost,127.0.0.1"
fi

# 并发实例告警 —— 多个 agy 交互/常驻实例并行刷新同一账号 Token 时易引发 401 竞争。
_agy_live=$(pgrep -f "\.local/bin/agy" 2>/dev/null | wc -l | tr -d ' ')
if [ "${_agy_live:-0}" -ge 3 ]; then
  echo "⚠ 已经有 ${_agy_live} 个 agy 实例在跑,可能互相刷新作废 OAuth token(报 401,长得像断网)。" >&2
  echo "  看一眼谁是僵尸:agy-ps    清掉:agy-ps -k" >&2
fi

# 真二进制:有的机器上 auto-updater 更新的是 agy-real,有的就叫 agy,两个都试。
REAL="$HOME/.local/bin/agy-real"
[ -x "$REAL" ] || REAL="$HOME/.local/bin/agy"
# 自指防护:万一本壳被装到了真二进制的位置,直接停,别递归把机器打爆。
case "$0" in "$REAL") echo "agy-wrapper: 装错位置了($0 == 真二进制路径),拒绝执行" >&2; exit 1 ;; esac

# 这些子命令不接受 --add-dir / --dangerously-skip-permissions,必须原样透传
case "${1:-}" in
  acp|agent|agents|changelog|help|install|mcp|mic-serve|models|plugin|plugins|remote-control|update|-h|--help|-v|--version)
    exec "$REAL" "$@" ;;
esac

# 把当前目录钉成工作区:
# agy 在 -p(print/非交互)模式下需要明确工作区路径以加载项目级 AGENTS.md 与 .agents/skills/。
ADD_DIR=""
case " $* " in
  *" --add-dir "*) ;;                     # 自己写了就不插手
  *) ADD_DIR="$PWD" ;;
esac

if [ -n "$ADD_DIR" ]; then
  set -- --add-dir "$ADD_DIR" "$@"
fi
case " $* " in
  *" --dangerously-skip-permissions "*) "$REAL" "$@" ;;
  *) "$REAL" --dangerously-skip-permissions "$@" ;;
esac
RC=$?

# 会话退出后在后台异步隐藏 magpie-agy-* 临时会话并汉化剩余标题，不阻塞终端
(
  if command -v agy-hide-bridge >/dev/null 2>&1; then
    agy-hide-bridge >/dev/null 2>&1
  elif [ -x "$HOME/.local/bin/agy-hide-bridge" ]; then
    "$HOME/.local/bin/agy-hide-bridge" >/dev/null 2>&1
  fi
  if command -v agy-title-zh >/dev/null 2>&1; then
    agy-title-zh >/dev/null 2>&1
  elif [ -x "$HOME/.local/bin/agy-title-zh" ]; then
    "$HOME/.local/bin/agy-title-zh" >/dev/null 2>&1
  fi
) >/dev/null 2>&1 &

exit $RC
